#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 ARTIFACT_DIRECTORY" >&2
    exit 1
fi

artifact_directory=$(cd "$1" && pwd)
root=$(cd "$(dirname "$0")/.." && pwd)
package_directory=$(mktemp -d)
trap 'rm -rf "$package_directory"' EXIT
checksum=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
swift_syntax_version=603.0.2

for module in GDExtension SwiftGodot SwiftGodotRuntime; do
    if [[ ! -d "$artifact_directory/$module.xcframework" ]]; then
        echo "Missing $artifact_directory/$module.xcframework" >&2
        exit 1
    fi
done

"$root/scripts/update-binary-package" \
    "$package_directory" \
    local-test \
    migueldeicaza/SwiftGodot \
    "$checksum" \
    "$checksum" \
    "$checksum"

mkdir -p "$package_directory/Artifacts" "$package_directory/Client"
for module in GDExtension SwiftGodot SwiftGodotRuntime; do
    cp -a "$artifact_directory/$module.xcframework" "$package_directory/Artifacts/"
done
cp "$root/scripts/binary-package/Package.local.swift" "$package_directory/Package.swift"
cp "$root/scripts/binary-package/BinaryClient.swift" "$package_directory/Client/main.swift"

swift run \
    --package-path "$package_directory" \
    --configuration release \
    --enable-experimental-prebuilts \
    BinaryClient

prebuilt_directory="$package_directory/.build/prebuilts/swift-syntax/$swift_syntax_version"
macro_support=$(find \
    "$prebuilt_directory" \
    -mindepth 1 \
    -maxdepth 1 \
    -type d \
    -name '*-MacroSupport' \
    -print \
    -quit 2>/dev/null || true)
if [[ -z $macro_support ]]; then
    echo "SwiftPM fell back to building swift-syntax $swift_syntax_version from source" >&2
    echo "Expected a MacroSupport prebuilt under $prebuilt_directory" >&2
    exit 1
fi

source_build=$(find \
    "$package_directory/.build" \
    -type d \
    -name 'SwiftSyntax*.build' \
    -print \
    -quit 2>/dev/null || true)
if [[ -n $source_build ]]; then
    echo "SwiftPM downloaded MacroSupport but still built swift-syntax from source" >&2
    echo "Unexpected source build directory: $source_build" >&2
    exit 1
fi

echo "Validated prebuilt SwiftSyntax at $macro_support"
