#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 ARTIFACT_DIRECTORY" >&2
    exit 1
fi

artifact_directory=$(cd "$1" && pwd)
root=$(cd "$(dirname "$0")/.." && pwd)
test_directory=$(mktemp -d)
package_directory="$test_directory/SwiftGodotBinary"
client_directory="$test_directory/BinaryClient"
trap 'rm -rf "$test_directory"' EXIT
checksum=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
swift_syntax_version=603.0.2

for module in GDExtension SwiftGodot SwiftGodotRuntime; do
    if [[ ! -d "$artifact_directory/$module.xcframework" ]]; then
        echo "Missing $artifact_directory/$module.xcframework" >&2
        exit 1
    fi
done

"$root/scripts/update-binary-package" \
    "$package_directory" \
    local-test \
    migueldeicaza/SwiftGodot \
    "$checksum" \
    "$checksum" \
    "$checksum"

mkdir -p \
    "$package_directory/Artifacts" \
    "$client_directory/Sources/BinaryClient"
for module in GDExtension SwiftGodot SwiftGodotRuntime; do
    cp -a "$artifact_directory/$module.xcframework" "$package_directory/Artifacts/"
done
cp "$root/scripts/binary-package/Package.local.swift" "$package_directory/Package.swift"
cp "$root/scripts/binary-package/Package.client.swift" "$client_directory/Package.swift"
cp \
    "$root/scripts/binary-package/BinaryClient.swift" \
    "$client_directory/Sources/BinaryClient/main.swift"

swift run \
    --package-path "$client_directory" \
    --configuration release \
    --enable-experimental-prebuilts \
    BinaryClient

prebuilt_directory="$client_directory/.build/prebuilts/swift-syntax/$swift_syntax_version"
macro_support=$(find \
    "$prebuilt_directory" \
    -mindepth 1 \
    -maxdepth 1 \
    -type d \
    -name '*-MacroSupport' \
    -print \
    -quit 2>/dev/null || true)
if [[ -z $macro_support ]]; then
    echo "SwiftPM fell back to building swift-syntax $swift_syntax_version from source" >&2
    echo "Expected a MacroSupport prebuilt under $prebuilt_directory" >&2
    exit 1
fi

# MacroSupport is the prebuilt supplied by SwiftPM.  Building the consuming
# macro implementation can still create a host-tool SwiftSyntax build directory;
# that directory does not indicate that MacroSupport fell back to source.
echo "Validated prebuilt MacroSupport at $macro_support"
