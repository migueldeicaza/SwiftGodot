#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 TAG" >&2
    echo "Dispatches binary publishing for an existing SwiftGodot GitHub release." >&2
    exit 1
fi

tag=$1
if [[ ! $tag =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Invalid release tag: $tag" >&2
    exit 1
fi

gh release view "$tag" --repo migueldeicaza/SwiftGodot > /dev/null
gh workflow run binaries.yml \
    --repo migueldeicaza/SwiftGodot \
    --ref main \
    -f "tag=$tag" \
    -f publish=true

echo "Dispatched binary publishing for $tag"
